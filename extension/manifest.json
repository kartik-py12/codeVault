{
    "manifest_version": 3,
    "name": "CodeVault1 - LeetCode Tracker",
    "version": "1.0",
    "description": "Track your DSA journey across LeetCode, organize problems, and save solutions",
    "content_scripts":[
        {
            "matches":["https://leetcode.com/problems/*"],
            "js":["content.js"]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": ["icons/save.svg", "icons/github.svg"],
            "matches": ["<all_urls>"]
        }
    ]
}